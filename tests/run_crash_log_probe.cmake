# テスト用のゲームフォルダ（dinput8.dll と mods/debugger/mod.dll）を作り、
# プローブにわざと例外を起こさせて、crash_*.log に記録されることを確かめる。
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK}/mods/debugger)
file(COPY_FILE ${LOADER} ${WORK}/dinput8.dll)
file(COPY_FILE ${MOD} ${WORK}/mods/debugger/mod.dll)
file(TO_NATIVE_PATH ${WORK}/dinput8.dll loader)
execute_process(COMMAND ${PROBE} ${loader} WORKING_DIRECTORY ${WORK} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "プローブが失敗しました（${result}）")
endif()
file(GLOB logs ${WORK}/mods/debugger/crash_*.log)
list(LENGTH logs count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "crash_*.log が1つではありません（${count}）")
endif()
file(READ ${logs} text)
if(NOT text MATCHES "diagnostics_only=1" OR NOT text MATCHES "code=c0000005")
    message(FATAL_ERROR "ログに例外が記録されていません:\n${text}")
endif()
message(STATUS "PASS crash log records the access violation")
file(REMOVE_RECURSE ${WORK})
